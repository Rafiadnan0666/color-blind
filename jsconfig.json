{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": false,
		"moduleResolution": "bundler"
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		".svelte-kit",
		"build",
		"dist",
		"**/*.d.ts"
	]
}
